{
  "name": "drums-pwa",
  "version": "1.0.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/starxmaker/drums-pwa/",
  "repository": {
    "type": "git",
    "url": "https://github.com/starxmaker/drums-pwa.git"
  },
  "scripts": {
    "prepare:audio": "node scripts/prepare-audio-assets.mjs",
    "prebuild": "npm run prepare:audio",
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "start": "npm run dev",
    "test": "vitest --run",
    "test:coverage": "vitest --run --coverage",
    "lint": "eslint src vite.config.ts vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@khmyznikov/pwa-install": "^0.6.3",
    "@reduxjs/toolkit": "^2.11.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.6.0",
    "react-redux": "^9.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.4.3",
    "@types/node": "^25.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^4.1.4",
    "7zip-bin": "^5.2.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.59.0",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.4"
  }
}
